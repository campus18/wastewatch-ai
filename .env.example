# Copy to .env in the project root. Never commit .env. All keys below are SERVER-SIDE only.

# --- Core (required) ---
MONGODB_URI=mongodb://127.0.0.1:27017/wastewatch
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=server/uploads
MAX_UPLOAD_MB=8

# --- AI detection (optional) ---
# Google Cloud Vision (LABEL_DETECTION). Leave empty -> UI shows "AI not configured".
GOOGLE_VISION_API_KEY=
# Set true to return clearly-labelled DEMO placeholders (no analysis is performed) when no key is set.
AI_DEMO_MODE=false

# --- Routing (optional) ---
# Base URL of an OSRM server, e.g. http://localhost:5000 (self-hosted). The public
# https://router.project-osrm.org demo server is for light testing only.
# Empty -> routes are SIMULATED (nearest-neighbour, straight lines) and labelled as such.
OSRM_BASE_URL=

# --- Satellite imagery (optional) ---
# Mapbox Static Images API (satellite-v9). Empty -> UI shows "imagery unavailable".
MAPBOX_ACCESS_TOKEN=

# --- Seeding (npm run seed) ---
# Create the first admin (required for a real deployment)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# true -> also create demo users + sample reports, all flagged "sample" in the UI
SEED_DEMO=false
SEED_DEMO_PASSWORD=
SEED_CENTER_LAT=20.5937
SEED_CENTER_LNG=78.9629
